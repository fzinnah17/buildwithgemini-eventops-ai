# What a deploy must not upload. Both `agents-cli deploy` and `gcloud` read this
# file in preference to .gitignore once it exists, so it includes .gitignore
# rather than restating it: a project keeps one list of build output and one
# list of things that are merely not worth uploading.
#!include:.gitignore

.git/
.gitignore
.gcloudignore

/extensions/

# Non-agent directories
portfolio-demo/
docs/
artifacts/
assets/
backups/
tests/
scripts/
deployment/
knowledge/
frontend/
node_modules/
.pytest_cache/
.google-agents-cli/

# Media and archive formats
*.gif
*.mp4
*.webm
*.png
*.jpg
*.jpeg
*.svg
*.pdf
*.zip
*.tar.gz
*.bundle
*.html
