# ==============================================================================
# EventOps AI — Environment Configuration Template
# Copy this file to .env and configure your Google Cloud project parameters.
# NEVER commit .env to version control.
# ==============================================================================

# 1. Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# 2. Vertex AI Agent Platform Reasoning Engine (Deployed Agent)
# Format: projects/{project_number}/locations/{region}/reasoningEngines/{engine_id}
AGENT_ENGINE_RESOURCE_NAME=projects/1234567890/locations/us-central1/reasoningEngines/0000000000000000000

# 3. Vertex AI Memory Bank (Long-term organizer memory)
MEMORY_BANK_ID=0000000000000000000
MEMORY_SERVICE_URI=agentengine://0000000000000000000

# 4. Google Cloud Storage Media Bucket (Visual direction & editorial assets)
EVENTOPS_MEDIA_BUCKET=eventops-ai-media-your-project-id

# 5. Serverless RAG Corpus for Event Operations Playbook Grounding
RAG_CORPUS_NAME=projects/1234567890/locations/us-central1/ragCorpora/0000000000000000000

# 6. Serving Configuration
PORT=8080
EVENTOPS_RUNTIME_MODE=live   # "live" for Cloud Agent Platform, "demo" for Zero-Cost Static Portfolio
