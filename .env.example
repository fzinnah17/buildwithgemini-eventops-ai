# EventOps AI — Environment Configuration Template
# Copy this file to .env and configure your GCP environment.
# NEVER commit .env to version control.

# Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Vertex AI Agent Platform Reasoning Engine Resource
# Format: projects/{project_number}/locations/{region}/reasoningEngines/{engine_id}
REASONING_ENGINE_RESOURCE=projects/1234567890/locations/us-central1/reasoningEngines/0000000000000000000

# Vertex AI Memory Bank ID & Service URI
MEMORY_BANK_ID=0000000000000000000
MEMORY_SERVICE_URI=agentengine://0000000000000000000

# Google Cloud Storage Media Bucket for EventOps Visual Assets
EVENTOPS_GCS_BUCKET=your-eventops-media-bucket

# Serverless RAG Corpus for Event Operations Playbook Grounding
RAG_CORPUS_ID=projects/1234567890/locations/us-central1/ragCorpora/0000000000000000000
